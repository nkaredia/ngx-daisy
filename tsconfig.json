{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@ngx-daisy/cdk": ["./dist/ngx-daisy"],
      "@ngx-daisy/cdk/*": ["./dist/ngx-daisy/*"],
      "@ngx-daisy/core": ["./dist/ngx-daisy-core"],
      "@ngx-daisy/core/*": ["./dist/ngx-daisy-core/*"],
      "@ngx-daisy/native": ["./dist/ngx-daisy-native"],
      "@ngx-daisy/native/*": ["./dist/ngx-daisy-native/*"]
    },
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/ngx-daisy/tsconfig.lib.json"
    },
    {
      "path": "./projects/ngx-daisy/tsconfig.spec.json"
    },
    {
      "path": "./projects/showcase/tsconfig.app.json"
    },
    {
      "path": "./projects/showcase/tsconfig.spec.json"
    },
    {
      "path": "./projects/ngx-daisy-core/tsconfig.lib.json"
    },
    {
      "path": "./projects/ngx-daisy-native/tsconfig.lib.json"
    },
    {
      "path": "./projects/ngx-daisy-native/tsconfig.spec.json"
    }
  ]
}
