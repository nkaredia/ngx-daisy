{
  "name": "ngx-daisy",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve showcase",
    "build:lib": "ng build ngx-daisy",
    "build:showcase": "ng build showcase",
    "build": "yarn build:lib && yarn build:showcase",
    "watch:lib": "ng build ngx-daisy --watch --configuration development",
    "test": "ng test ngx-daisy --watch=false && ng test showcase --watch=false && yarn test:styles && yarn test:builder",
    "test:styles": "node scripts/check-daisyui-config.mjs",
    "test:builder": "node --test tools/showcase-builder/*.test.cjs",
    "postinstall": "node tools/showcase-builder/sync-schemas.cjs"
  },
  "private": true,
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@lucide/angular": "^1.61.0",
    "@ngx-daisy/showcase-builder": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "daisyui": "^5.7.50",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "postcss": "^8.5.31",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "8.3.0",
    "vitest": "^5.0.0"
  },
  "volta": {
    "node": "22.23.0"
  },
  "workspaces": [
    "tools/showcase-builder"
  ]
}
