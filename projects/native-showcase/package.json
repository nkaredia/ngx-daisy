{
  "name": "@ngx-daisy/native-showcase",
  "version": "0.0.1",
  "private": true,
  "main": "src/main.ts",
  "scripts": {
    "android": "ns run android",
    "ios": "node tools/run-ios.cjs",
    "bundle:android": "webpack --env android --env aot --env nativescriptLibPath --env buildPath=../../dist/native-check",
    "bundle:ios": "webpack --env ios --env aot --env nativescriptLibPath --env buildPath=../../dist/native-check",
    "check": "ngc -p tsconfig.json --noEmit",
    "check:styles": "node tools/check-styles.cjs",
    "check:icons": "node --test tools/icon-artwork.test.cjs && node tools/check-icon-bundles.cjs",
    "check:shell": "node --test tools/shell.test.cjs"
  },
  "dependencies": {
    "@angular/animations": "22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-browser-dynamic": "22.2.3",
    "@angular/router": "^22.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@nativescript-community/ui-svg": "^0.2.29",
    "@nativescript/angular": "^22.0.2",
    "@nativescript/core": "^9.1.3",
    "colorjs.io": "^0.6.1",
    "lucide": "^1.61.0",
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@nativescript/ios": "9.1.0",
    "@nativescript/tailwind": "^4.1.0",
    "@nativescript/types": "^9.1.4",
    "@nativescript/webpack": "^5.0.39",
    "@ngtools/webpack": "22.2.3",
    "daisyui": "^5.7.50",
    "nativescript": "^9.1.2",
    "postcss": "^8.5.31",
    "sass": "^1.100.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "webpack": "^5.105.0"
  }
}
